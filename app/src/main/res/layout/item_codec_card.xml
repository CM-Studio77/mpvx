<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/neo_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Format name and HW badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_format_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HEVC (H.265)"
            android:textColor="@color/kr_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_hw_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/neo_badge_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="HARDWARE"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Decoder Name / Identifier -->
    <TextView
        android:id="@+id/card_decoder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:text="c2.qti.hevc.decoder"
        android:textColor="@color/kr_text_secondary"
        android:textSize="12sp" />

    <!-- Badges Row -->
    <LinearLayout
        android:id="@+id/card_badges_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badge_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/neo_segment_container"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="7680x4320 @60fps"
            android:textColor="@color/kr_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/badge_hdr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/neo_segment_container"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="HDR10+"
            android:textColor="#FFB74D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_10bit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/neo_segment_container"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="10-BIT"
            android:textColor="#81D4FA"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expandable Details Section -->
    <LinearLayout
        android:id="@+id/card_details_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/kr_border_subtle" />

        <!-- Profiles & Levels -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profiles &amp; Levels:"
            android:textColor="@color/kr_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_profiles_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/kr_text_primary"
            android:textSize="12sp" />

        <!-- Color Formats -->
        <TextView
            android:id="@+id/card_colors_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supported Color Formats:"
            android:textColor="@color/kr_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_colors_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/kr_text_primary"
            android:textSize="12sp" />

        <!-- Hardware Features -->
        <TextView
            android:id="@+id/card_features_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware Capabilities:"
            android:textColor="@color/kr_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_features_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#00E5FF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
