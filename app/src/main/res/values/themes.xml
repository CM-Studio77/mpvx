<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme.Player" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/kr_background</item>
        <item name="android:navigationBarColor">@color/kr_background</item>
        <item name="android:windowBackground">@color/kr_background</item>
        <item name="android:colorBackground">@color/kr_background</item>
        <item name="colorSurface">@color/kr_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="accentColor">@color/kr_accent_primary</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:textColorPrimary">@color/kr_text_primary</item>
        <item name="android:textColorSecondary">@color/kr_text_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.Player.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Player.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.Player.Dialog</item>
        <item name="dialogTheme">@style/Theme.Player.Dialog</item>
    </style>

    <style name="Theme.Player.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/kr_dialog_bg</item>
        <item name="android:colorBackground">@color/kr_surface</item>
        <item name="colorSurface">@color/kr_surface</item>
        <item name="android:textColorPrimary">@color/kr_text_primary</item>
        <item name="android:textColorSecondary">@color/kr_text_secondary</item>
        <item name="colorAccent">@color/kr_accent_primary</item>
        <item name="android:colorAccent">@color/kr_accent_primary</item>
    </style>

    <style name="Theme.Player" parent="BaseTheme.Player">
    </style>

    <style name="Theme.Player.Video" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="accentColor">@color/kr_accent_primary</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:alertDialogTheme">@style/Theme.Player.Dialog.Dark</item>
        <item name="alertDialogTheme">@style/Theme.Player.Dialog.Dark</item>
    </style>

    <style name="Theme.Player.Dialog.Dark" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/kr_dialog_bg</item>
        <item name="android:colorBackground">#0B0E14</item>
        <item name="android:colorBackgroundFloating">#141722</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
    </style>

    <!-- OLED Pure Pitch Black for AMOLED Displays -->
    <style name="Theme.Player.OledPureBlack" parent="">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- screenshot mode: the highlight values-television gives a real TV -->
    <style name="ShowcaseTv" parent="">
        <item name="colorControlHighlight">@color/white</item>
    </style>

    <style name="Theme.Player.Home" parent="BaseTheme.Player">
        <item name="accentColor">@color/kr_accent_primary</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:windowBackground">@color/kr_background</item>
        <item name="android:colorBackground">@color/kr_background</item>
        <item name="colorSurface">@color/kr_surface</item>
        <item name="android:textColorPrimary">@color/kr_text_primary</item>
        <item name="android:textColorSecondary">@color/kr_text_secondary</item>
        <item name="android:statusBarColor">@color/kr_background</item>
        <item name="android:navigationBarColor">@color/kr_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- the preference widgets need a DayNight theme -->
    <style name="Theme.Player.Settings" parent="BaseTheme.Player">
        <item name="accentColor">@color/kr_accent_primary</item>
        <item name="colorAccent">@color/kr_accent_primary</item>
        <item name="android:colorAccent">@color/kr_accent_primary</item>
        <item name="android:windowBackground">@color/kr_background</item>
        <item name="android:colorBackground">@color/kr_background</item>
        <item name="colorSurface">@color/kr_surface</item>
        <item name="android:textColorPrimary">@color/kr_text_primary</item>
        <item name="android:textColorSecondary">@color/kr_text_secondary</item>
        <item name="android:statusBarColor">@color/kr_background</item>
        <item name="android:navigationBarColor">@color/kr_background</item>
        <item name="android:colorControlActivated">@color/kr_accent_primary</item>
        <item name="android:colorControlHighlight">#200D59F2</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Material's bottom sheet needs its own theme here -->
    <style name="Theme.Player.RecentSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="accentColor">@color/kr_accent_primary</item>
        <item name="colorAccent">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="colorSurface">@color/kr_surface</item>
        <item name="android:textColorPrimary">@color/kr_text_primary</item>
        <item name="android:textColorSecondary">@color/kr_text_secondary</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/kr_glass_sheet_bg</item>
    </style>

    <style name="RecentMenuItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">?android:attr/textColorSecondary</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- FilmInfoActivity gives each button its fill or outline -->
    <style name="FilmInfoButton" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="HomeTileQuarter" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="PanelAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/panel_in</item>
        <item name="android:windowExitAnimation">@anim/panel_out</item>
    </style>

    <style name="ExoStyledControls.Button.Center.Secondary" parent="ExoStyledControls.Button.Center">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="MediaStoreChooserDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item> <!-- when focused, the line scrolls -->
    </style>

