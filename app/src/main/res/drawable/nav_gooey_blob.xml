<?xml version="1.0" encoding="utf-8"?>
<!-- MPVX Gooey Liquid Fusion Main Blob with Specular Glass Inset -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Liquid Base Gradient -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B3A855F7"
                android:endColor="#E606B6D4" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Specular Highlight -->
    <item
        android:bottom="20dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- 1.5dp Crisp Rim -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
