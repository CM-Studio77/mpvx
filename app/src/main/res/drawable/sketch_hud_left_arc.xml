    <path android:pathData="M 16,64 m -2.5,0 a 2.5,2.5 0 1 0 5,0 a 2.5,2.5 0 1 0 -5,0" android:fillColor="#FFFFFF" />
    <path android:pathData="M 14,74 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0" android:fillColor="#00E5FF" />
    <path android:pathData="M 8,86 m -2,0 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0" android:fillColor="#FFFFFF" />
