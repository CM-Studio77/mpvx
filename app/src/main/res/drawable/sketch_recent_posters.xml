<?xml version="1.0" encoding="utf-8"?>
<!-- MPVX Vertical Smartphone Mockup Demo (72dp x 128dp) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="128dp"
    android:viewportWidth="72"
    android:viewportHeight="128">

    <!-- Phone Chassis Frame -->
    <path
        android:pathData="M 8,0 H 64 A 8,8 0 0 1 72,8 V 120 A 8,8 0 0 1 64,128 H 8 A 8,8 0 0 1 0,120 V 8 A 8,8 0 0 1 8,0 Z"
        android:fillColor="#0D111A" />
