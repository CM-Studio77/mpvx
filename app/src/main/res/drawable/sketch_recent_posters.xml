    <path android:pathData="M 6,32 H 24 V 60 H 6 Z" android:fillColor="#1F2A3F" />
    <path android:pathData="M 27,32 H 45 V 60 H 27 Z" android:fillColor="#00E5FF" />
    <path android:pathData="M 48,32 H 66 V 60 H 48 Z" android:fillColor="#1F2A3F" />
