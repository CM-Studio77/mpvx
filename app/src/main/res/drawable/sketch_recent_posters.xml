    <path android:pathData="M 6,90 H 66 V 110 H 6 Z" android:fillColor="#161C2A" />
  

    <!-- Bottom Gesture Bar -->
    <path
        android:pathData="M 27,123 H 45 V 124.5 H 27 Z"
        android:fillColor="#66FFFFFF" />
</vector>